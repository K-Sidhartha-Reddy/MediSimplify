MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_DB_NAME=medical_report_simplifier
SECRET_KEY=change_this_to_a_long_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
UPLOAD_DIR=./uploads
TESSERACT_CMD=tesseract
CORS_ORIGINS=https://<your-vercel-app>.vercel.app,http://localhost:3000

# Use a Hugging Face Hub repo that contains your fine-tuned summarizer.
# Example: your-username/t5-medical-new
SIMPLIFIER_MODEL_NAME_OR_PATH=your-username/t5-medical-new

# Optional, useful if you make the model repo private.
HF_TOKEN=

# Recommended on Hugging Face Spaces so model downloads cache across restarts.
HF_HOME=/data/.huggingface
TRANSFORMERS_CACHE=/data/.cache/huggingface